<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Suite">
  <listeners>
    <listener class-name="com.example.tests.AllureListener"/>
  </listeners>
  
  <test name="Chrome Headless Tests">
    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>
    <classes>
      <class name="com.example.tests.LoginTests"/>
      <class name="com.example.tests.CartTests"/>
      <class name="com.example.tests.CheckoutTests"/>
      <class name="com.example.tests.InventorySortTests"/>
    </classes>
  </test>

    <test name="edge Headless Tests">
        <parameter name="browser" value="edge"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.example.tests.LoginTests"/>
            <class name="com.example.tests.CartTests"/>
            <class name="com.example.tests.CheckoutTests"/>
            <class name="com.example.tests.InventorySortTests"/>
        </classes>
    </test>
  
</suite>
